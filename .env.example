# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIRST_ADMIN_EMAIL: Optional email address reserved for automatic Level 1 (Admin)
# promotion upon completing email OTP verification during Sign Up (when no Admin exists yet).
# If omitted, the very first verified user to register is promoted to Level 1 (Admin).
FIRST_ADMIN_EMAIL=""

# ALLOW_REPEAT_SIGNUP_TEST: Set to "true" during testing to allow repeated Sign Up
# with the same email address (overwriting/resetting the existing user record after OTP
# verification) and to keep DELETE /api/auth/test-reset enabled. Keep "false" in production.
ALLOW_REPEAT_SIGNUP_TEST="false"

# ==============================================================================
# REAL EMAIL DELIVERY (Option A: Resend API — Preferred / Highest Priority)
# ==============================================================================
# Configure in AI Studio Settings -> Secrets (or your local .env file):
RESEND_API_KEY=""
EMAIL_FROM="MasBina Security <onboarding@resend.dev>"

# ==============================================================================
# REAL EMAIL DELIVERY (Option B: Gmail SMTP with App Password — Fallback)
# ==============================================================================
# Used automatically if RESEND_API_KEY is not set:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MasBina Security <your-gmail-address@gmail.com>"
